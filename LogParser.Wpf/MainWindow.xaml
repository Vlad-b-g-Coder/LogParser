<Window x:Class="LogParser.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctl="clr-namespace:LogParser.Wpf.Controls"
        Title="LogParser — анализатор логов" Width="1320" Height="820" MinWidth="1060" MinHeight="620"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}" FontFamily="Segoe UI" FontSize="13"
        AllowDrop="True" Drop="Window_Drop" WindowStartupLocation="CenterScreen">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ===== Шапка ===== -->
        <Border Grid.Row="0" Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1"
                Padding="20,12" IsEnabled="{Binding IsIdle}">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="LogParser" FontSize="20" FontWeight="Bold"/>
                        <TextBlock Text="Логи из файлов, текста и сторонних сервисов в одной таблице" Style="{StaticResource Caption}" Margin="0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="⟳  Обновить все" Style="{StaticResource ToolButton}" Click="RefreshAll_Click"
                                ToolTip="Перечитать все источники и заново проверить их"/>
                        <Button Content="Экспорт…" Style="{StaticResource ToolButton}" Click="Export_Click"
                                ToolTip="Сохранить видимые записи в TXT, CSV или JSON"/>
                        <Button Content="Очистить" Style="{StaticResource ToolButton}" Margin="0" Click="Clear_Click"/>
                    </StackPanel>
                </Grid>

                <WrapPanel Margin="0,12,0,0">
                    <TextBlock Text="Добавить источник:" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="{StaticResource MutedBrush}"/>
                    <Button Content="＋  Файл…" Style="{StaticResource PrimaryButton}" Click="AddFile_Click"/>
                    <Button Content="Текст из буфера…" Style="{StaticResource ToolButton}" Click="PasteText_Click"/>
                    <Button Content="Сервис мониторинга" Style="{StaticResource ToolButton}" Click="Vendor_Click"
                            ToolTip="Демо стороннего сервиса со своим API (через адаптер)"/>
                    <Button Content="pegast.ru…" Style="{StaticResource ToolButton}" Click="Pegast_Click"
                            ToolTip="JSON-ответ поиска pegast.ru"/>
                    <Button Content="Загрузить пример" Style="{StaticResource ToolButton}" Click="Sample_Click"/>
                    <TextBlock Text="Формат файла:" VerticalAlignment="Center" Margin="12,0,6,0" Foreground="{StaticResource MutedBrush}"/>
                    <ComboBox x:Name="FormatBox" Width="110" SelectedIndex="0" VerticalAlignment="Center" Padding="8,4">
                        <ComboBoxItem Content="Авто"/>
                        <ComboBoxItem Content="JSON"/>
                        <ComboBoxItem Content="key=value"/>
                        <ComboBoxItem Content="CSV"/>
                    </ComboBox>
                </WrapPanel>
            </StackPanel>
        </Border>

        <!-- ===== Основная часть ===== -->
        <Grid Grid.Row="1" Margin="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="350"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Источники -->
            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <DockPanel Margin="0,0,0,10">
                        <ctl:StatusBadge DockPanel.Dock="Left" Width="22" Height="22" State="{Binding OverallState}" Margin="0,0,10,0"/>
                        <TextBlock Text="Источники" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </DockPanel>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Sources}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,0,8" Padding="10" CornerRadius="8" Background="#FAFBFD"
                                            BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Enabled}" Value="False">
                                                        <Setter Property="Opacity" Value="0.5"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <ctl:StatusBadge Width="26" Height="26" State="{Binding State}"
                                                             VerticalAlignment="Top" Margin="0,1,10,0"/>

                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis" ToolTip="{Binding Location}"/>
                                                <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" FontSize="12" Margin="0,2,0,0">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding State}" Value="Error">
                                                                    <Setter Property="Foreground" Value="{StaticResource ErrorBrush}"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding State}" Value="Warning">
                                                                    <Setter Property="Foreground" Value="#B45309"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>

                                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top">
                                                <CheckBox IsChecked="{Binding Enabled, Mode=TwoWay}" VerticalAlignment="Center" Margin="0,0,4,0"
                                                          ToolTip="Учитывать источник в общей таблице"/>
                                                <Button Content="⟳" Style="{StaticResource IconButton}" Click="ReloadSource_Click" ToolTip="Перечитать источник"/>
                                                <Button Content="✕" Style="{StaticResource IconButton}" Click="RemoveSource_Click" ToolTip="Убрать источник"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- Легенда кружков -->
                    <WrapPanel Grid.Row="2" Margin="0,8,0,0">
                        <StackPanel Orientation="Horizontal" Margin="0,0,14,0">
                            <Ellipse Width="10" Height="10" Fill="{StaticResource OkBrush}" Margin="0,0,5,0"/>
                            <TextBlock Text="работает" Style="{StaticResource Caption}" Margin="0"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,14,0">
                            <Ellipse Width="10" Height="10" Fill="{StaticResource WarningBrush}" Margin="0,0,5,0"/>
                            <TextBlock Text="есть замечания" Style="{StaticResource Caption}" Margin="0"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,14,0">
                            <Ellipse Width="10" Height="10" Fill="{StaticResource ErrorBrush}" Margin="0,0,5,0"/>
                            <TextBlock Text="недоступен" Style="{StaticResource Caption}" Margin="0"/>
                        </StackPanel>
                    </WrapPanel>
                </Grid>
            </Border>

            <!-- Записи -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Фильтры -->
                <Border Grid.Row="0" Style="{StaticResource Card}" Padding="14,12">
                    <StackPanel>
                        <WrapPanel>
                            <StackPanel Margin="0,0,14,0">
                                <TextBlock Text="Уровень" Style="{StaticResource Caption}"/>
                                <ComboBox Width="160" ItemsSource="{Binding Levels}" DisplayMemberPath="Title"
                                          SelectedItem="{Binding SelectedLevel, Mode=TwoWay}" Padding="8,4"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,14,0">
                                <TextBlock Text="Поиск по тексту и источнику" Style="{StaticResource Caption}"/>
                                <TextBox Width="260" Padding="6,4" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,14,0">
                                <TextBlock Text="С даты" Style="{StaticResource Caption}"/>
                                <DatePicker Width="130" SelectedDate="{Binding DateFrom, Mode=TwoWay}"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,14,0">
                                <TextBlock Text="По дату" Style="{StaticResource Caption}"/>
                                <DatePicker Width="130" SelectedDate="{Binding DateTo, Mode=TwoWay}"/>
                            </StackPanel>
                            <Button Content="Сбросить" Style="{StaticResource ToolButton}" VerticalAlignment="Bottom"
                                    Margin="0" Click="ResetFilters_Click"/>
                        </WrapPanel>

                        <WrapPanel Margin="0,12,0,0">
                            <Button Style="{StaticResource Chip}" Click="Chip_Click" Tag="Debug" ToolTip="Показать все уровни">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="10" Height="10" Fill="{StaticResource DebugBrush}" Margin="0,0,6,0"/>
                                    <TextBlock Text="{Binding DebugCount, StringFormat=Debug  {0}}"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource Chip}" Click="Chip_Click" Tag="Info" ToolTip="Info и выше">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="10" Height="10" Fill="{StaticResource InfoBrush}" Margin="0,0,6,0"/>
                                    <TextBlock Text="{Binding InfoCount, StringFormat=Info  {0}}"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource Chip}" Click="Chip_Click" Tag="Warning" ToolTip="Warning и выше">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="10" Height="10" Fill="{StaticResource WarningBrush}" Margin="0,0,6,0"/>
                                    <TextBlock Text="{Binding WarningCount, StringFormat=Warning  {0}}"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource Chip}" Click="Chip_Click" Tag="Error" ToolTip="Error и выше">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="10" Height="10" Fill="{StaticResource ErrorBrush}" Margin="0,0,6,0"/>
                                    <TextBlock Text="{Binding ErrorCount, StringFormat=Error  {0}}"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource Chip}" Click="Chip_Click" Tag="Critical" ToolTip="Только Critical">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="10" Height="10" Fill="{StaticResource CriticalBrush}" Margin="0,0,6,0"/>
                                    <TextBlock Text="{Binding CriticalCount, StringFormat=Critical  {0}}"/>
                                </StackPanel>
                            </Button>
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <!-- Таблица -->
                <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,12,0,0" ClipToBounds="True">
                    <Grid>
                        <DataGrid ItemsSource="{Binding Visible}" SelectedItem="{Binding SelectedEntry, Mode=TwoWay}"
                                  AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                                  GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#EEF1F6"
                                  BorderThickness="0" Background="White" RowHeight="32"
                                  CanUserAddRows="False" CanUserResizeRows="False" SelectionMode="Single"
                                  EnableRowVirtualization="True" AlternatingRowBackground="#FBFCFE">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Время" Width="160"
                                                    Binding="{Binding Timestamp, StringFormat=yyyy-MM-dd HH:mm:ss}"
                                                    ElementStyle="{StaticResource CellText}"/>
                                <DataGridTemplateColumn Header="Уровень" Width="120">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0">
                                                <Ellipse Width="10" Height="10" Margin="0,0,7,0"
                                                         Fill="{Binding Level, Converter={StaticResource LevelBrush}}"/>
                                                <TextBlock Text="{Binding Level}"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Сообщение" Width="*" Binding="{Binding Message}"
                                                    ElementStyle="{StaticResource CellText}"/>
                                <DataGridTextColumn Header="Источник" Width="230" Binding="{Binding Source}"
                                                    ElementStyle="{StaticResource CellText}"/>
                            </DataGrid.Columns>
                        </DataGrid>

                        <!-- Пустое состояние -->
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="Пока нет ни одного источника" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                            <TextBlock Text="Перетащите файлы логов в окно или нажмите «Добавить источник»"
                                       Foreground="{StaticResource MutedBrush}" Margin="0,6,0,14" HorizontalAlignment="Center"/>
                            <Button Content="Загрузить пример" Style="{StaticResource PrimaryButton}" Margin="0"
                                    HorizontalAlignment="Center" Click="Sample_Click"/>
                        </StackPanel>

                        <TextBlock Text="Под фильтры ничего не подошло" Foreground="{StaticResource MutedBrush}" FontSize="15"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Visibility="{Binding NoMatches, Converter={StaticResource BoolToVis}}"/>
                    </Grid>
                </Border>

                <!-- Подробности выбранной записи -->
                <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,12,0,0" Padding="14,10"
                        Visibility="{Binding SelectedEntry, Converter={StaticResource NullToVis}}">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Копировать" Style="{StaticResource ToolButton}" Margin="12,0,0,0"
                                VerticalAlignment="Top" Click="CopyEntry_Click"/>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding SelectedEntry.Timestamp, StringFormat=yyyy-MM-dd HH:mm:ss}"
                                           Foreground="{StaticResource MutedBrush}" FontSize="12"/>
                                <TextBlock Text="  ·  " Foreground="{StaticResource MutedBrush}" FontSize="12"/>
                                <TextBlock Text="{Binding SelectedEntry.Source}" Foreground="{StaticResource MutedBrush}" FontSize="12"/>
                            </StackPanel>
                            <TextBox Text="{Binding SelectedEntry.Message, Mode=OneWay}" IsReadOnly="True" BorderThickness="0"
                                     Background="Transparent" TextWrapping="Wrap" MaxHeight="90" FontSize="14" Margin="0,4,0,0"
                                     VerticalScrollBarVisibility="Auto"/>
                        </StackPanel>
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>

        <!-- ===== Строка состояния ===== -->
        <Border Grid.Row="2" Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="20,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                    <ctl:StatusBadge Width="18" Height="18" State="{Binding OverallState}" Margin="0,0,8,0"/>
                    <TextBlock Text="{Binding OverallText}" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock Grid.Column="1" Text="{Binding StatusText}" Foreground="{StaticResource MutedBrush}"
                           TextTrimming="CharacterEllipsis" Margin="24,0" VerticalAlignment="Center"/>
                <ProgressBar Grid.Column="2" Width="90" Height="6" IsIndeterminate="True" Margin="0,0,16,0"
                             Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"/>
                <TextBlock Grid.Column="3" Text="{Binding CountText}" FontWeight="SemiBold" VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Window>
