<Window x:Class="LogParser.Wpf.PasteTextWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Добавить текст как источник" Width="640" Height="460" MinWidth="480" MinHeight="320"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}" FontFamily="Segoe UI" FontSize="13">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Вставьте строки лога (например, из stdin или буфера обмена)" Margin="0,0,0,8"/>

        <TextBox x:Name="Input" Grid.Row="1" AcceptsReturn="True" AcceptsTab="True" TextWrapping="NoWrap"
                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                 FontFamily="Consolas" FontSize="12.5" Padding="8"/>

        <DockPanel Grid.Row="2" Margin="0,12,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="Добавить" Style="{StaticResource PrimaryButton}" IsDefault="False" Click="Ok_Click"/>
                <Button Content="Отмена" Style="{StaticResource ToolButton}" Margin="0" IsCancel="True"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Формат:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <ComboBox x:Name="FormatBox" Width="120" SelectedIndex="0" Padding="8,4">
                    <ComboBoxItem Content="Авто"/>
                    <ComboBoxItem Content="JSON"/>
                    <ComboBoxItem Content="key=value"/>
                    <ComboBoxItem Content="CSV"/>
                </ComboBox>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
